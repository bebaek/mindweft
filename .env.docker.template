# Canonical Mindweft environment names; matching MINIGENT_* names remain supported.
MINDWEFT_AUTH_MODE=static-tokens
MINDWEFT_AUTH_TOKENS={"{{ bw get password MINDWEFT_AUTH_TOKEN }}":{"user_id":"demo-user","tenant_id":"demo-tenant","is_admin":true}}
MINDWEFT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY={{ bw get password OPENROUTER_API_KEY }}
OPENROUTER_MODEL=openai/gpt-5.4-mini
MINDWEFT_LOG_FORMAT=json

