MINIGENT_LLM_PROVIDER=mock

# Remote deployment defaults
# MINIGENT_AUTH_MODE=jwt
# MINIGENT_LOG_FORMAT=json

# Optional admin SQLite store for tenant execution config
# MINIGENT_TENANT_CONFIG_SOURCE=store-with-defaults
# MINIGENT_ADMIN_DB_PATH=/data/minigent-admin.db
# MINIGENT_ADMIN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4-mini
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_NAME=minigent

# MCP over Streamable HTTP
# MINIGENT_MCP_SERVERS=[{"name":"demo","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ..."}}]

# Developer example: prompt-overlay skills plus an explicit capability profile.
# This is useful when you want multiple behavioral overlays on a thread without
# implicitly widening tool or MCP access.
# MINIGENT_AUTH_MODE=dev-headers
# MINIGENT_TENANT_EXECUTION_CONFIGS={
#   "demo-tenant":{
#     "llm":{"provider":"mock"},
#     "tools":{
#       "allowed_local_tools":["echo","current_time"],
#       "mcp_servers":[
#         {"name":"home-assistant","url":"https://ha.example/api/mcp","headers":{"Authorization":"Bearer ..."}},
#         {"name":"docs","url":"https://docs.example/mcp","headers":{"Authorization":"Bearer ..."}}
#       ]
#     },
#     "skills":{
#       "default_skill":"support",
#       "items":[
#         {"name":"support","system_prompt":"Answer as a concise support agent."},
#         {"name":"safe-actions","system_prompt":"Require explicit confirmation before high-risk actions."},
#         {"name":"home-assistant","system_prompt":"When operating against Home Assistant, discover entities before acting, prefer exact entity IDs once resolved, inspect current state before mutation, and require explicit confirmation before security-sensitive actions."}
#       ]
#     },
#     "capability_profiles":{
#       "default_profile":"support",
#       "items":[
#         {"name":"support","allowed_local_tools":["echo","current_time"]},
#         {"name":"home-assistant","allowed_local_tools":["current_time"],"mcp_server_names":["home-assistant"]},
#         {"name":"home-assistant-docs","allowed_local_tools":["current_time"],"mcp_server_names":["home-assistant","docs"]}
#       ]
#     }
#   }
# }
# Example thread create payloads against that config:
# {"skill_names":["support","safe-actions"],"capability_profile":"support"}
# {"skill_names":["home-assistant","safe-actions"],"capability_profile":"home-assistant"}

# MiniRAG notes skill example
# Requires `uv sync --extra minirag` and a valid MiniRAG DB path.
# MINIGENT_MINIRAG_DB_PATH=/path/to/your/minirag.db
# MINIGENT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"openai","model":"gpt-5.4-mini"},"tools":{"allowed_local_tools":["retrieve_knowledge"]},"skills":{"default_skill":"notes","items":[{"name":"notes","description":"Answer from the user's MiniRAG notes first.","system_prompt":"You are working primarily from the user's personal notes and knowledge base.\n\nFor any question that may be answered from the notes, retrieve from the notes first before answering from general knowledge.\n\nWhen tool results contain relevant note content, ground the answer in those retrieved notes, distinguish clearly between direct support and inference, and prefer concise synthesis over speculation.\n\nIf the notes do not contain enough information, say that explicitly. You may then give a clearly labeled best-effort answer if useful.\n\nDo not claim the notes say something unless the retrieval results directly support it.","allowed_local_tools":["retrieve_knowledge"]}]}}}
# To opt in per thread instead of making it the default skill, remove `"default_skill":"notes"`.

# Voice daemon
# MINIGENT_VOICE_WAKE_PHRASE=hey minigent  # stdin backend text trigger
# MINIGENT_VOICE_LOCATION=Austin, TX, US; timezone=America/Chicago
# MINIGENT_VOICE_DEBUG_SHOW_PROMPT=false
# MINIGENT_VOICE_STT_PROVIDER=openai
# MINIGENT_VOICE_STT_DEVICE=cpu
# MINIGENT_VOICE_STT_COMPUTE_TYPE=int8
# MINIGENT_VOICE_STT_LANGUAGE=en
# MINIGENT_VOICE_TTS_PROVIDER=console
# MINIGENT_VOICE_TTS_VOICE=Samantha
# MINIGENT_VOICE_WAKEWORD_PROVIDER=porcupine
# MINIGENT_VOICE_STT_MODEL=gpt-4o-mini-transcribe
# For OpenRouter, prefer an audio-capable chat model such as openai/gpt-audio
# For faster-whisper, `base` is a good starting point for local command transcription
# MINIGENT_VOICE_DEBUG_CAPTURE_PATH=/tmp/minigent-last-capture.wav
# MINIGENT_VOICE_STT_DEBUG_PATH=/tmp/minigent-stt-debug
# MINIGENT_VOICE_STT_GAIN=1.0
# MINIGENT_VOICE_STT_NORMALIZE_PEAK=false
# MINIGENT_VOICE_STT_NORMALIZE_TARGET_PEAK=0.8
# MINIGENT_VOICE_AUDIO_SAMPLE_RATE=16000
# MINIGENT_VOICE_AUDIO_BLOCK_SIZE=512
# MINIGENT_VOICE_END_SILENCE_MS=800
# MINIGENT_VOICE_MAX_RECORD_SECONDS=15
# MINIGENT_VOICE_POST_WAKE_SPEECH_TIMEOUT_MS=2500
# MINIGENT_VOICE_POST_WAKE_SETTLE_MS=250
# MINIGENT_VOICE_WAKEWORD_PREROLL_MS=750
# MINIGENT_VOICE_STT_PAD_LEADING_MS=250
# MINIGENT_VOICE_STT_PAD_TRAILING_MS=500
