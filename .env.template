# MINIGENT_VOICE_OWW_MODEL=okay_nabu
# MINIGENT_VOICE_OWW_THRESHOLD=0.5
# MINIGENT_VOICE_AUDIO_DEVICE=
# PICOVOICE_ACCESS_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
