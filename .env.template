MINIGENT_LLM_PROVIDER=mock

# Remote deployment defaults
# MINIGENT_AUTH_MODE=jwt
# MINIGENT_LOG_FORMAT=json
# MINIGENT_MAX_ITERATIONS=16
# MINIGENT_TOOL_TIMEOUT_SECONDS=60

# Static token auth (when MINIGENT_AUTH_MODE=static-tokens)
# MINIGENT_AUTH_TOKENS={"your-token":{"user_id":"user","tenant_id":"tenant","is_admin":false}}

# Optional generic console sign-in. Generate password_hash with:
#   uv run python scripts/hash-session-password.py
# Session credentials work alongside any MINIGENT_AUTH_MODE for browser access.
# MINIGENT_SESSION_CREDENTIALS={"admin":{"password_hash":"scrypt$...","principal":{"user_id":"admin","tenant_id":"platform","is_admin":true}}}
# MINIGENT_SESSION_SECRET=replace-with-at-least-32-random-bytes
# MINIGENT_SESSION_TTL_SECONDS=28800
# MINIGENT_SESSION_COOKIE_SECURE=true
# MINIGENT_SESSION_ALLOWED_ORIGINS=https://minigent.example.com
# Per-username login attempts; capacity 0 disables this protection.
# MINIGENT_SESSION_LOGIN_RATE_LIMIT_CAPACITY=10
# MINIGENT_SESSION_LOGIN_RATE_LIMIT_REFILL_PER_SECOND=0.0166666667

# JWT auth (when MINIGENT_AUTH_MODE=jwt)
# MINIGENT_JWT_ISSUER=https://issuer.example
# MINIGENT_JWT_AUDIENCE=your-audience
# MINIGENT_JWT_SHARED_SECRET=your-shared-secret
# MINIGENT_JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# MINIGENT_JWT_JWKS_CACHE_SECONDS=300
# MINIGENT_JWT_ALGORITHMS=RS256
# MINIGENT_JWT_USER_CLAIM=sub
# MINIGENT_JWT_TENANT_CLAIM=tenant_id
# MINIGENT_JWT_ADMIN_CLAIM=is_admin

# Context compaction
# MINIGENT_CONTEXT_COMPACTION_ENABLED=false

# Logging
# MINIGENT_LOG_LEVEL=INFO
# MINIGENT_LOG_PLAINTEXT_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
# MINIGENT_LOG_JSON_FIELDS=message,level,logger,timestamp
# MINIGENT_LOG_JSON_LEVEL_KEY=level
# MINIGENT_LOG_JSON_LOGGER_KEY=logger
# MINIGENT_LOG_JSON_TIMESTAMP_KEY=timestamp
# MINIGENT_LOG_JSON_MESSAGE_KEY=message
# MINIGENT_LOG_JSON_EXCEPTION_KEY=exception
# MINIGENT_LOG_JSON_ROOT_KEY=
# MINIGENT_LOG_JSON_INCLUDE_TRACE_CONTEXT=false

# OpenTelemetry
# MINIGENT_OTEL_ENABLED=false
# MINIGENT_OTEL_EXPORTER=otlp
# MINIGENT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# MINIGENT_OTEL_EXPORTER_OTLP_HEADERS=
# MINIGENT_OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=10
# MINIGENT_OTEL_SERVICE_NAME=minigent

# Docker image publish helper defaults read by scripts/docker-build-push.sh
# IMAGE_NAMESPACE=<github-user-or-org>
# IMAGE_NAME=minigent
# IMAGE_TAG=latest
# PLATFORMS=linux/amd64
# REGISTRY=ghcr.io

# Optional SQLite persistence
# MINIGENT_THREAD_DB_PATH=/data/minigent-threads.db
# MINIGENT_TENANT_CONFIG_SOURCE=store-with-defaults
# Require authenticated tenant IDs to exist and be active in the admin tenant registry.
# MINIGENT_TENANT_REGISTRY_REQUIRED=false
# Require authenticated users to have active tenant membership in the admin tenant registry.
# MINIGENT_TENANT_USER_REGISTRY_REQUIRED=false
# MINIGENT_ADMIN_DB_PATH=/data/minigent-admin.db
# MINIGENT_ADMIN_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional browser quick-add catalog. Header values are redacted in API responses and restored server-side.
# MINIGENT_ADMIN_MCP_SERVER_CATALOG=[{"id":"web-search","title":"Web search","description":"Search web and news.","detail":"Local sidecar · 3 tools","server":{"name":"web-search","url":"http://127.0.0.1:8766/mcp","headers":{},"allowed_tools":["brave_web_search","brave_news_search","brave_llm_context"]}}]
# Optional admin-only external grant control plane. Uses short-lived forwarded identity tokens;
# it is not loaded into tenant execution config or exposed as model tools.
# MINIGENT_ADMIN_EXTERNAL_GRANT_PROVIDERS=[{"id":"example-grants","title":"Example grants","description":"Manage authoritative external resource grants.","base_url":"http://127.0.0.1:8769","audience":"example-grants","read_scopes":["grants:read"],"write_scopes":["grants:write"],"allowed_permissions":["read","read_write"],"resources_path":"/v1/resources","audit_path":"/v1/resource-grant-audit"}]
# Encrypted private data. Consent tables may share this database and key with private values.
# MINIGENT_PRIVATE_VALUE_DB_PATH=/data/minigent-private.db
# Active key plus optional versioned keyrings for rotation.
# MINIGENT_PRIVATE_VALUE_ENCRYPTION_KEY=base64-encoded-32-byte-key
# MINIGENT_PRIVATE_VALUE_ENCRYPTION_KEYS={"1":"old-base64-key","2":"active-base64-key"}
# MINIGENT_PRIVATE_VALUE_KEY_VERSION=1
# MINIGENT_PRIVATE_VALUE_REENCRYPT_ON_STARTUP=false
# MINIGENT_PRIVATE_CONSENT_DB_PATH=/data/minigent-private.db
# MINIGENT_PRIVATE_CONSENT_ENCRYPTION_KEY=base64-encoded-32-byte-key
# MINIGENT_PRIVATE_CONSENT_ENCRYPTION_KEYS={"1":"old-base64-key","2":"active-base64-key"}
# MINIGENT_PRIVATE_CONSENT_KEY_VERSION=1
# MINIGENT_PRIVATE_CONSENT_REENCRYPT_ON_STARTUP=false
# MINIGENT_PRIVATE_CONSENT_REQUEST_TTL_SECONDS=600
# MINIGENT_PRIVATE_CONSENT_GRANT_TTL_SECONDS=300
# MINIGENT_PRIVATE_CONSENT_AUDIT_TTL_SECONDS=2592000
# MINIGENT_PRIVATE_CONSENT_MAX_AUDIT_RECORDS_PER_SCOPE=1000

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

