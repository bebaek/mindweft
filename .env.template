# MINIGENT_LLM_DEBUG_REQUEST_LOG_PATH=/tmp/minigent-llm-requests.jsonl
# MINIGENT_LLM_PROMPT_CACHE_KEY=thread
# ChatGPT Codex Responses reasoning summary request controls.
# Use off/none/null/false/0 to omit either field.
# MINIGENT_LLM_REASONING_EFFORT=medium
# MINIGENT_LLM_REASONING_SUMMARY=auto
# Continue reasoning-only Responses outputs before reporting a retryable provider stall.
# MINIGENT_RESPONSES_REASONING_ONLY_RETRIES=3
# MINIGENT_LLM_EXTRA_HEADERS={"x-custom-header":"value"}
# MINIGENT_LLM_MODEL=your-model-id
# MINIGENT_LLM_URL=https://provider.example/v1/responses
# MINIGENT_LLM_ACCOUNT_ID_HEADER=x-provider-account-id

