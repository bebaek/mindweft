# MiniRAG notes skill example
# Requires `uv sync --extra minirag` and a valid MiniRAG DB path.
# MINIGENT_MINIRAG_DB_PATH=/path/to/your/minirag.db
# MINIGENT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"openai","model":"gpt-5.4-mini"},"tools":{"allowed_local_tools":["retrieve_knowledge"]},"skills":{"default_skill":"notes","items":[{"name":"notes","description":"Answer from the user's MiniRAG notes first.","system_prompt":"You are working primarily from the user's personal notes and knowledge base.\n\nFor any question that may be answered from the notes, retrieve from the notes first before answering from general knowledge.\n\nWhen tool results contain relevant note content, ground the answer in those retrieved notes, distinguish clearly between direct support and inference, and prefer concise synthesis over speculation.\n\nIf the notes do not contain enough information, say that explicitly. You may then give a clearly labeled best-effort answer if useful.\n\nDo not claim the notes say something unless the retrieval results directly support it.","allowed_local_tools":["retrieve_knowledge"]}]}}}
# To opt in per thread instead of making it the default skill, remove `"default_skill":"notes"`.

# Minigent client voice/audio settings
