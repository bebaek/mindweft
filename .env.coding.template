# Copy to .env.coding and edit for your workspace:
#   cp .env.coding.template .env.coding
#   uv run python scripts/run_coding_workspace.py --env-file .env.coding

# Workspace exposed to the filesystem MCP server. Keep this as narrow as possible.
MINIGENT_CODING_WORKSPACE=/path/to/workspace

# Local Minigent API bind address.
MINIGENT_HOST=127.0.0.1
MINIGENT_PORT=8000

# Local stdio-to-HTTP bridge for @modelcontextprotocol/server-filesystem.
# The runner starts it with read-only tool and path filters by default.
# If MINIGENT_TENANT_EXECUTION_CONFIGS defines allowed_tools for this MCP server,
# the runner mirrors that list into the bridge's --allowed-tool filter.
MINIGENT_CODING_BRIDGE_NAME=fs-workspace
MINIGENT_CODING_BRIDGE_HOST=127.0.0.1
MINIGENT_CODING_BRIDGE_PORT=8765

# Defaults for local trusted-header development. Use jwt/bearer-token auth for shared deployments.
MINIGENT_AUTH_MODE=dev-headers
MINIGENT_CODING_TENANT_ID=demo-tenant
# By default, the runner injects a coding-workspace skill into an explicit tenant config
# if the config does not already have one. Set false to disable that behavior.
# MINIGENT_CODING_INJECT_WORKSPACE_SKILL=true

# The convenience runner generates a mock-LLM tenant config if this is omitted.
# Uncomment and replace the llm block for a real provider.
# MINIGENT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"mock"},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace"]}]}}}

# Generic OAuth LLM example for coding profiles. OAuth settings are global; the tenant
# config selects the OAuth-backed LLM while keeping filesystem access behind the inspect
# capability profile. Start the runner, then open:
#   http://127.0.0.1:8000/oauth/generic/open
# MINIGENT_OAUTH_STORE_PATH=.data/oauth-coding.json
# MINIGENT_OAUTH_PROVIDER_ID=your-provider-id
# MINIGENT_OAUTH_CLIENT_ID=your-client-id
# MINIGENT_OAUTH_AUTHORIZE_URL=https://provider.example/oauth/authorize
# MINIGENT_OAUTH_TOKEN_URL=https://provider.example/oauth/token
# MINIGENT_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/generic/callback
# MINIGENT_OAUTH_SCOPE="openid profile offline_access"
# MINIGENT_OAUTH_AUTH_PARAMS={"prompt":"login"}
# Optional: if your provider requires an account/org header populated from a JWT claim.
# MINIGENT_LLM_ACCOUNT_ID_HEADER=x-provider-account-id
# MINIGENT_OAUTH_ACCOUNT_ID_JWT_CLAIM=auth.account_id
# MINIGENT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"generic-oauth","model":"your-model-id","base_url":"https://provider.example/v1/responses","extra_headers":{"x-provider-feature":"enabled"}},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace"]}]}}}

# Optional: replace the filesystem MCP server command. The runner appends no extra args when this is set.
# MINIGENT_CODING_FILESYSTEM_COMMAND=npx -y @modelcontextprotocol/server-filesystem /path/to/workspace
