# Canonical Mindweft environment names; matching MINIGENT_* names remain supported.
# Copy to .env.coding and edit for your workspace:
#   cp .env.coding.template .env.coding
#   uv run mindweft-coding-workspace --env-file .env.coding

# Workspace(s) exposed to the filesystem MCP server. Keep these as narrow as possible.
# Use a single path, a comma-separated list, or repeat --workspace on the runner CLI.
# The plural MINDWEFT_CODING_WORKSPACES is preferred for multiple roots; the singular
# MINDWEFT_CODING_WORKSPACE remains supported for compatibility.
MINDWEFT_CODING_WORKSPACES=/path/to/workspace
# MINDWEFT_CODING_WORKSPACES=/path/to/repo1,/path/to/repo2

# Local Mindweft API bind address.
MINDWEFT_HOST=127.0.0.1
MINDWEFT_PORT=8000

# Coding threads default to durable user-local storage under $XDG_STATE_HOME/mindweft,
# falling back to ~/.local/state/mindweft. An existing minigent state directory remains in use
# until moved explicitly. Set MINDWEFT_THREAD_DB_PATH only to override this selection.

# Optional declarative MCP server specs live in mindweft.toml as [[coding.mcp_server_specs]].
# This keeps the unified config self-contained instead of pointing at a secondary server file.
# Use the built-in fs/text/shell switches below for simple setups, or add inline MCP specs to
# mindweft.toml for multi-server/custom-tool setups. See docs/coding-workspace.md.
#
# Legacy env-based setups can still use MINDWEFT_CODING_MCP_SERVERS_FILE; config export will
# inline that file's contents as [[coding.mcp_server_specs]] rather than preserving the file ref.
# MINDWEFT_CODING_MCP_SERVERS_FILE=.data/coding-mcp-servers.json
#
# To add codebase-memory-mcp as an optional graph-navigation layer, install the
# codebase-memory-mcp binary separately and include a `codebase-memory` stdio server in
# [[coding.mcp_server_specs]].

# Optional stdio MCP gateway. When enabled, all stdio servers from inline coding MCP specs
# are exposed by one gateway process at /mcp/<server-name> instead of separate
# bridge processes/ports. Only use this with generated tenant config, or update explicit
# MINDWEFT_TENANT_EXECUTION_CONFIGS URLs to match the gateway URLs.
# MINDWEFT_CODING_MCP_GATEWAY_ENABLED=true
# MINDWEFT_CODING_MCP_GATEWAY_PORT=8765
# MINDWEFT_CODING_MCP_GATEWAY_PATH_PREFIX=/mcp

# Local stdio-to-HTTP bridge for @modelcontextprotocol/server-filesystem.
# The runner starts it with read-only tool and path filters by default.
# If MINDWEFT_TENANT_EXECUTION_CONFIGS defines allowed_tools for this MCP server,
# the runner mirrors that list into the bridge's --allowed-tool filter.
MINDWEFT_CODING_BRIDGE_NAME=fs-workspace
MINDWEFT_CODING_BRIDGE_HOST=127.0.0.1
MINDWEFT_CODING_BRIDGE_PORT=8765
# Optional comma-separated path glob filters passed to the filesystem bridge. By default,
# the runner mirrors the configured fs-workspace tenant path_policy into the bridge. These
# variables override that mirrored policy when set. Allow globs override deny globs.
# MINDWEFT_CODING_BRIDGE_DENY_GLOBS=**/.env*,**/.git/**,**/.venv/**,**/.pytest_cache/**,**/.ruff_cache/**,**/.uv-cache/**
# MINDWEFT_CODING_BRIDGE_ALLOW_GLOBS=**/.env*.template,**/.env*.driver.sh

# Optional targeted text-read MCP bridge. Disabled by default. When enabled and the runner
# generates MINDWEFT_TENANT_EXECUTION_CONFIGS, it adds text-workspace to the `inspect`
# capability profile for efficient exact line-range, around-line, and per-file search reads.
# If you set MINDWEFT_TENANT_EXECUTION_CONFIGS yourself, include a text-workspace MCP server
# with read_text_file_lines, read_text_file_around, and search_text_file in allowed_tools,
# and add text-workspace to the inspect profile's mcp_server_names.
# MINDWEFT_CODING_TEXT_ENABLED=true
# MINDWEFT_CODING_TEXT_BRIDGE_NAME=text-workspace
# MINDWEFT_CODING_TEXT_BRIDGE_PORT=8767

# Optional trusted-local shell MCP bridge. Disabled by default. When enabled and the runner
# generates MINDWEFT_TENANT_EXECUTION_CONFIGS, it adds a non-default `test` capability
# profile exposing shell-workspace.run_command.
# MINDWEFT_CODING_SHELL_ENABLED=true
# MINDWEFT_CODING_SHELL_BRIDGE_NAME=shell-workspace
# MINDWEFT_CODING_SHELL_BRIDGE_PORT=8766
# Optional comma-separated command prefix allowlist for shell-workspace.run_command.
# If omitted, the shell MCP server allows any command within its other constraints.
# Example: allow git inspection, grep/search, and test/lint commands while blocking `cat .env`.
# MINDWEFT_CODING_SHELL_ALLOWED_COMMAND_PREFIXES=git,rg,find,ls,pwd,uv run pytest,uv run ruff check,uv run basedpyright

# Defaults for local trusted-header development. Use jwt/bearer-token auth for shared deployments.
MINDWEFT_AUTH_MODE=dev-headers
MINDWEFT_CODING_TENANT_ID=demo-tenant
# By default, the runner injects a coding-workspace skill into an explicit tenant config
# if the config does not already have one. Set false to disable that behavior.
# MINDWEFT_CODING_INJECT_WORKSPACE_SKILL=true

# The convenience runner generates a mock-LLM tenant config if this is omitted.
# Uncomment and replace the llm block for a real provider.
# Long JSON values can be kept in a separate file by using the matching *_FILE variable;
# paths are resolved relative to this env file when they are not absolute. For example:
#   MINDWEFT_TENANT_EXECUTION_CONFIGS_FILE=.data/mindweft-tenant-config.json
# MINDWEFT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"mock"},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations. Prefer working with git-tracked source files; use git status or git ls-files when needed to distinguish tracked, untracked, ignored, and generated files. Do not read or write secrets such as .env files unless the user explicitly asks and the active tool policy permits it."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace"]}]}}}

# Explicit config example with optional targeted text-read support. If you set
# MINDWEFT_TENANT_EXECUTION_CONFIGS yourself, the runner will not add text-workspace
# automatically; include both the server and profile mapping here and enable the text bridge above.
# MINDWEFT_CODING_TEXT_ENABLED=true
# MINDWEFT_CODING_TEXT_BRIDGE_NAME=text-workspace
# MINDWEFT_CODING_TEXT_BRIDGE_PORT=8767
# MINDWEFT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"mock"},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}},{"name":"text-workspace","url":"http://127.0.0.1:8767/mcp","headers":{},"allowed_tools":["read_text_file_lines","read_text_file_around","search_text_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations. Prefer targeted text-read MCP tools for exact line ranges when they are available; use broader filesystem reads only when broader file context is needed. Prefer working with git-tracked source files; use git status or git ls-files when needed to distinguish tracked, untracked, ignored, and generated files. Do not read or write secrets such as .env files unless the user explicitly asks and the active tool policy permits it."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace","text-workspace"]}]}}}

# Explicit config example with optional trusted-local shell support. If you set
# MINDWEFT_TENANT_EXECUTION_CONFIGS yourself, the runner will not add shell-workspace or
# the `test` profile automatically; include both here and enable the shell bridge above.
# MINDWEFT_CODING_SHELL_ENABLED=true
# MINDWEFT_CODING_SHELL_BRIDGE_NAME=shell-workspace
# MINDWEFT_CODING_SHELL_BRIDGE_PORT=8766
# MINDWEFT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"mock"},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}},{"name":"shell-workspace","url":"http://127.0.0.1:8766/mcp","headers":{},"allowed_tools":["run_command"]}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations. Prefer working with git-tracked source files; use git status or git ls-files when needed to distinguish tracked, untracked, ignored, and generated files. Do not read or write secrets such as .env files unless the user explicitly asks and the active tool policy permits it."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace"]},{"name":"test","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace","shell-workspace"]}]}}}

# Generic OAuth LLM example for coding profiles. OAuth settings are global; the tenant
# config selects the OAuth-backed LLM while keeping filesystem access behind the inspect
# capability profile. Start the runner, then open:
#   http://127.0.0.1:8000/oauth/generic/open
# MINDWEFT_OAUTH_STORE_PATH=.data/oauth-coding.json
# MINDWEFT_OAUTH_PROVIDER_ID=your-provider-id
# MINDWEFT_OAUTH_CLIENT_ID=your-client-id
# MINDWEFT_OAUTH_AUTHORIZE_URL=https://provider.example/oauth/authorize
# MINDWEFT_OAUTH_TOKEN_URL=https://provider.example/oauth/token
# MINDWEFT_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/generic/callback
# MINDWEFT_OAUTH_SCOPE="openid profile offline_access"
# MINDWEFT_OAUTH_AUTH_PARAMS={"prompt":"login"}
# Or put the JSON object in a file and use:
# MINDWEFT_OAUTH_AUTH_PARAMS_FILE=.data/oauth-auth-params.json
# Optional: if your provider requires an account/org header populated from a JWT claim.
# MINDWEFT_LLM_ACCOUNT_ID_HEADER=x-provider-account-id
# MINDWEFT_OAUTH_ACCOUNT_ID_JWT_CLAIM=auth.account_id
# MINDWEFT_TENANT_EXECUTION_CONFIGS={"demo-tenant":{"llm":{"provider":"generic-oauth","model":"your-model-id","base_url":"https://provider.example/v1/responses","extra_headers":{"x-provider-feature":"enabled"}},"tools":{"allowed_local_tools":["current_time","calculator"],"mcp_servers":[{"name":"fs-workspace","url":"http://127.0.0.1:8765/mcp","headers":{},"allowed_tools":["list_allowed_directories","list_directory","read_file"],"path_policy":{"deny_globs":["**/.env*","**/.git/**","**/.venv/**","**/.pytest_cache/**","**/.ruff_cache/**","**/.uv-cache/**"],"allow_globs":["**/.env*.template"]}}]},"skills":{"default_skill":"coding-workspace","items":[{"name":"coding-workspace","system_prompt":"You are assisting with a code workspace. When the user says current directory, workspace, repo, or repository root, use its absolute path. Filesystem MCP tools require explicit absolute paths; always pass the path argument for directory and file operations. Prefer working with git-tracked source files; use git status or git ls-files when needed to distinguish tracked, untracked, ignored, and generated files. Do not read or write secrets such as .env files unless the user explicitly asks and the active tool policy permits it."}]},"capability_profiles":{"default_profile":"inspect","items":[{"name":"inspect","allowed_local_tools":["current_time","calculator"],"mcp_server_names":["fs-workspace"]}]}}}

# Optional: replace the filesystem MCP server command. The runner appends no extra args when this is set.
# MINDWEFT_CODING_FILESYSTEM_COMMAND=npx -y @modelcontextprotocol/server-filesystem /path/to/workspace
