# Unified Minigent config facade.
# Copy this file to minigent.toml and keep secrets in your shell, OS keychain, or .env.
# Existing MINIGENT_* / provider env vars still override values from this file.

profile = "local-coding"

[app]
host = "127.0.0.1"
port = 8000
thread_db_path = ".data/minigent-coding-threads.db"
# max_iterations = 16
# tool_timeout_seconds = 60

[auth]
mode = "development"

[llm]
provider = "mock"
# provider = "openrouter"
# model = "anthropic/claude-sonnet-4.5"
# api_key_env = "OPENROUTER_API_KEY"
# base_url = "https://openrouter.ai/api/v1"
# provider = "anthropic"
# model = "claude-haiku-4-5"
# api_key_env = "ANTHROPIC_API_KEY"
# base_url = "https://api.anthropic.com/v1"
# prompt_cache_enabled = true
# thinking_enabled = true
# thinking_budget_tokens = 1024

[coding]
enabled = true
workspaces = ["/Users/you/code"]
shell_enabled = false
# shell_allowed_command_prefixes = ["uv ", "pytest ", "git "]
# bridge_deny_globs = ["**/.env*", "**/.git/**"]
# bridge_allow_globs = ["**/.env*.template"]
# default_workspace_scope = "my-app"
# [coding.workspace_scopes.my-app]
# roots = ["/Users/you/code/my-app"]
# description = "Primary app repository"

[mcp]
# servers = [
#   { name = "filesystem", url = "http://127.0.0.1:8765/mcp", headers = {} },
# ]

[voice]
# The first unified config pass intentionally keeps voice simple; detailed audio tuning
# remains available through MINIGENT_VOICE_* env vars.

[quality]
enabled = false
